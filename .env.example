# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_OWNER_ID=your_numeric_telegram_id

# ─── OpenRouter (openrouter.ai/keys) ──────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# النموذج المستخدم — يمكن تغييره:
# anthropic/claude-3.5-sonnet  (الافتراضي — أفضل للكود)
# anthropic/claude-3-haiku     (أسرع وأرخص)
# openai/gpt-4o
# openai/gpt-4o-mini
# meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=anthropic/claude-3.5-sonnet

# ─── GitHub ───────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=hseon19990-jpg
GITHUB_REPO=Assist
GITHUB_BRANCH=main

# ─── إعدادات اختيارية ─────────────────────────────────────────
# عدد الرسائل المحفوظة في الذاكرة (الافتراضي: 40)
MAX_HISTORY=40

# مهلة انتظار إجابة ask_user بالميلي ثانية (الافتراضي: 300000 = 5 دقائق)
ASK_TIMEOUT_MS=300000
